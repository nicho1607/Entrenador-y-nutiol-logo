# FitMind AI — environment variable template.
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.

# --- Database (PostgreSQL) ---
# Connection string to YOUR locally-running PostgreSQL instance.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# You create the database yourself from the psql SQL shell (see README).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitmind?schema=public"

# --- Auth.js / NextAuth ---
# A random secret used to sign session tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# The canonical URL of the app (used by NextAuth for callbacks).
NEXTAUTH_URL="http://localhost:3000"

# --- Optional AI recommendations ---
# AI recommendations are OPTIONAL and OFF by default. The app runs fully with
# NO API key: the current build ships a DISABLED AI seam (no live provider), so
# leaving this "false" (or unset) yields rule-based recommendations only.
FITMIND_AI_ENABLED="false"
